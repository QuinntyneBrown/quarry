@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Open an anchored surface

enum CsAnchorPosition {
  below_start
  below_end
  above_start
  above_end
  right
  left
}

enum CsDismissReason {
  select
  escape
  outside_click
  trigger
  detach
}

class CsMenuDirective {
  +csMenu: InputSignal<TemplateRef<unknown>>
  +open: ModelSignal<boolean>
  +position: InputSignal<CsAnchorPosition>
  +closeOnSelect: InputSignal<boolean>
  +opened: OutputEmitterRef<void>
  +closed: OutputEmitterRef<CsDismissReason>
  -restoreTarget: HTMLElement | null
  -overlayRef: OverlayRef | null
  +openMenu(): void
  +closeMenu(reason: CsDismissReason): void
  -buildPositions(): ConnectedPosition[]
}

class CsMenuItemDirective {
  +disabled: InputSignal<boolean>
  +danger: InputSignal<boolean>
  +checkable: InputSignal<boolean>
  +checked: ModelSignal<boolean>
  +role: Signal<'menuitem' | 'menuitemcheckbox' | 'menuitemradio'>
  +triggered: OutputEmitterRef<CsMenuItemTrigger>
}

class PopoverComponent {
  +open: ModelSignal<boolean>
  +position: InputSignal<CsAnchorPosition>
  +trapFocus: InputSignal<boolean>
  +ariaLabel: InputSignal<string>
  +closed: OutputEmitterRef<CsDismissReason>
}

class AccountMenuComponent {
  +account: InputSignal<Account>
  +actions: InputSignal<readonly AccountAction[]>
  +actionSelected: OutputEmitterRef<AccountAction>
  +signOut: OutputEmitterRef<void>
}

class Account {
  +displayName: string
  +email?: string
  +avatarSrc?: string
  +roleLabel?: string
}

class AccountAction {
  +id: string
  +label: string
  +icon?: string
  +routerLink?: unknown
  +danger?: boolean
}

class CsMenuItemTrigger {
  +itemId: string
  +source: 'pointer' | 'keyboard'
}

interface OverlayRef {
  +attach(portal: Portal<unknown>): void
  +detach(): void
  +updatePosition(): void
}

CsMenuDirective --> CsAnchorPosition : prefers
CsMenuDirective --> CsDismissReason : reports
PopoverComponent --> CsAnchorPosition : prefers
PopoverComponent --> CsDismissReason : reports
CsMenuDirective ..> OverlayRef : attaches through
PopoverComponent ..> OverlayRef : attaches through
CsMenuDirective o-- "0..*" CsMenuItemDirective : manages focus across
CsMenuItemDirective ..> CsMenuItemTrigger : emits
AccountMenuComponent *-- "1" CsMenuDirective : composes
AccountMenuComponent o-- "1..*" CsMenuItemDirective : renders
AccountMenuComponent --> "1" Account : displays
AccountMenuComponent --> "1..*" AccountAction : offers
@enduml
