@startuml
title UML sequence behaviour — Open and close a dialog
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Application user" as user
box "Frontend — Consuming application" #E0F2FE
  participant "Feature page" as page
end box
box "Frontend — Cornerstone dialog runtime" #D1FADF
  participant "DialogService" as service
  participant "DialogRef" as ref
  participant "DialogShellComponent" as shell
end box
box "Frontend — Angular CDK" #ECFDF3
  participant "Dialog and Overlay" as cdk
  participant "FocusTrap" as trap
  participant "BlockScrollStrategy" as scroll
end box
box "Browser — platform" #FFF4E5
  participant "Document and focus" as browser
end box

user -> page : Activate the trigger control
page -> service : open<CsGateDecision>(component, config)
service -> browser : Read document.activeElement
browser --> service : Trigger element
service -> scroll : Block page scrolling per L2-102
scroll -> browser : Lock document scroll and compensate scrollbar width
service -> cdk : Attach the component portal with cs-backdrop
cdk -> shell : Instantiate with the configured size
shell -> shell : Apply small, default, or large size per L2-102
shell -> trap : Create the focus trap around the panel
trap -> browser : Move focus to the first tabbable element per L2-102
shell -> browser : Set aria-labelledby and aria-describedby from the projected ids
service --> ref : Return the typed handle
ref --> page : closed observable of CsGateDecision

user -> browser : Press Tab at the last tabbable element
browser -> trap : Focus leaves the panel
trap -> browser : Wrap focus to the first tabbable element

user -> shell : Activate the confirm action
shell -> ref : close(result)
ref -> cdk : Detach the overlay
trap -> trap : Destroy the trap
service -> scroll : Release the scroll block
scroll -> browser : Restore document scrolling
shell -> browser : Return focus to the trigger element per L2-102
ref --> page : Emit CsGateDecision on closed
page --> user : Updated screen behind the closed dialog
@enduml
