@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Find and pick a value

Person(dev, "Application developer", "Implements the query handler")
Person(user, "Application user", "Narrows a large option set")

System_Boundary(cornerstone, "Cornerstone") {
  Container(lib, "Component library", "Angular standalone components", "Supplies SearchFieldComponent, ComboboxComponent, DateFieldComponent, and DateTimeFieldComponent")
  Container(theme, "Theme stylesheet", "Sass / CSS custom properties", "Declares control, listbox, chip, and focus tokens")
  Container(docs, "Documentation site", "Angular application", "Publishes the value contract, the keyboard map, and the announcement formats")
}

System_Boundary(app, "Consuming application") {
  Container(page, "Feature page", "Angular components", "Binds the form control and renders the resolved option set")
  Container(services, "Application services", "Angular injectables", "Resolves queries, holds the option source, and owns the date validators")
}

System_Ext(cdk, "Angular CDK", "Overlay and virtual scroll")
System_Ext(browser, "Browser platform", "Native inputs, platform picker, and local timezone")

Rel(dev, page, "Implements the query handler in")
Rel(page, lib, "Binds the form control and the option set to")
Rel(lib, page, "Emits the debounced query and the selection to")
Rel(page, services, "Resolves the query through")
Rel(services, page, "Returns the resolved options to")
Rel(lib, theme, "Resolves control and listbox values from")
Rel(lib, cdk, "Positions and virtualizes the listbox through", "Overlay and cdk-virtual-scroll")
Rel(lib, browser, "Renders native search and date hosts in")
Rel(user, browser, "Types and selects in")
Rel(browser, lib, "Reports key, input, and change events to")
Rel(docs, lib, "Documents the timezone contract of")
@enduml
