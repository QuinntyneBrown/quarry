@startuml
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
title System Context — Attach a file

Person(dev, "Application developer", "Wires the upload handler and the accept rules")
Person(youth, "Youth", "Attaches evidence to a Word Up assignment submission")
Person(administrator, "Administrator", "Uploads a roster file and branding assets in Word Up")

System(cornerstone, "Cornerstone", "Angular UI library supplying the file picker and dropzone")
System_Ext(app, "Consuming application", "Word Up Angular application performing the transfer and reporting progress")
System_Ext(cdk, "Angular CDK", "Live announcer and focus utilities")
System_Ext(browser, "Browser platform", "Native file browser, drag and drop events, and object URLs")
System_Ext(npm, "npm registry", "Distributes the published package")

Rel(dev, cornerstone, "Composes the file selection surface from")
Rel(dev, app, "Implements the upload handler in")
Rel(cornerstone, app, "Emits upload and retry intents to")
Rel(app, cornerstone, "Reports progress and failure back to")
Rel(cornerstone, cdk, "Announces drop and rejection states through")
Rel(cornerstone, npm, "Is published to")
Rel(app, npm, "Installs from")
Rel(cornerstone, browser, "Opens the file browser and creates object URLs in")
Rel(youth, browser, "Drops or browses for a file in")
Rel(administrator, browser, "Selects a roster file in")
@enduml
