@startuml
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
title System Context — Take a quiz

Person(youth, "Youth participant", "Answers the questions of an attempt and reads the result")
Person(mentor, "Mentor", "Reads the marked result of a participant")
Person(dev, "Application developer", "Builds the Word Up quiz screen from Cornerstone components")

System(cornerstone, "Cornerstone", "Angular UI library supplying the quiz composites")
System_Ext(app, "Consuming application", "Word Up Angular application owning the answer key, marking, and persistence")
System_Ext(cdk, "Angular CDK", "Behaviour primitives for overlays, focus trapping, and key management")
System_Ext(npm, "npm registry", "Distributes the published package")
System_Ext(browser, "Browser platform", "Renders the questions and reports input events")

Rel(dev, cornerstone, "Composes the quiz screen from")
Rel(dev, app, "Implements assessment services in")
Rel(app, cornerstone, "Supplies the quiz and result view models to")
Rel(cornerstone, app, "Emits answer, navigation, and submit intents to")
Rel(cornerstone, cdk, "Builds the confirm dialog and key handling on")
Rel(cornerstone, npm, "Is published to")
Rel(app, npm, "Installs from")
Rel(cornerstone, browser, "Renders the attempt into")
Rel(browser, youth, "Presents the questions and the result to")
Rel(browser, mentor, "Presents the marked result to")
Rel(youth, browser, "Answers and submits in")
@enduml
