@startuml
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
title System Context — Record consent

Person(guardian, "Guardian", "Reviews and changes the consent recorded for a young person")
Person(admin, "Administrator", "Records a consent decision on a guardian's behalf and reads its history")
Person(dev, "Application developer", "Builds the Word Up consent screen from Cornerstone components")

System(cornerstone, "Cornerstone", "Angular UI library supplying the consent panel composite")
System_Ext(app, "Consuming application", "Word Up portal; owns the consent record, its rules, and its audit trail")
System_Ext(cdk, "Angular CDK", "Dialog, focus, and live announcement primitives")
System_Ext(browser, "Browser platform", "Renders the panel and exposes storage and console sinks the panel does not use")
System_Ext(npm, "npm registry", "Distributes the published package")

Rel(guardian, browser, "Grants and revokes consent in")
Rel(admin, browser, "Reads consent history in")
Rel(dev, cornerstone, "Composes the consent screen from")
Rel(dev, app, "Implements the consent rules in")
Rel(app, cornerstone, "Supplies the consent view model to")
Rel(cornerstone, app, "Emits typed decision, revoke, and update intents to")
Rel(cornerstone, cdk, "Builds dialog and announcement behaviour on")
Rel(cornerstone, npm, "Is published to")
Rel(app, npm, "Installs from")
Rel(cornerstone, browser, "Renders personal data as text in, and writes none to its storage or console")
@enduml
