@startuml
title UML sequence behaviour — Submit work against an assignment
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Youth participant" as youth
box "Frontend — Consuming application" #E0F2FE
  participant "Feature page" as page
  participant "Submission service" as submissions
end box
box "Frontend — Cornerstone work composites" #D1FADF
  participant "AssignmentCardComponent" as card
  participant "SubmissionStatusComponent" as status
  participant "AchievementCardComponent" as badge
end box
box "Browser — platform" #FFF4E5
  participant "Rendering and input" as browser
end box

submissions -> page : Supply assignment and submission records
page -> card : Bind AssignmentView
card -> card : Render due date, status, metadata, and instructions per L2-120
page -> status : Bind SubmissionView and the version list
status -> status : Render evidence, feedback, and history per L2-120
status --> browser : Rendered submission state

youth -> browser : Expand the assignment and select 'submit'
browser -> card : Activation event
card -> page : Emit AssignmentAction with kind 'submit'
page -> submissions : Create the submission and attach the evidence
submissions --> page : Submission recorded with a new version ordinal
page -> status : Bind the updated SubmissionView per L2-120
status -> status : Move the status to 'submitted' and prepend the version per L2-120
status --> browser : Repaint the status and history

opt Changes requested earlier
  submissions -> page : Supply feedback with decision 'request-changes'
  page -> status : Bind the feedback into SubmissionView
  status -> status : Render the feedback against the current version per L2-120
  youth -> browser : Select 'resubmit'
  browser -> status : Activation event
  status -> page : Emit CsSubmissionAction with kind 'resubmit'
  page -> submissions : Open a new version
  submissions --> page : Version count incremented
end

opt Submission approved and a badge awarded
  submissions -> page : Report the approval
  page -> badge : Bind the achievement as earned
  badge -> badge : Render art, criteria, and award date per L2-122
  badge --> browser : Earned badge presented beside the assignment
end

status -> status : Perform no upload and hold no rule
browser --> youth : Submission state presented
@enduml
