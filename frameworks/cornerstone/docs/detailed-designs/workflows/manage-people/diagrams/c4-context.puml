@startuml
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
title System Context — Manage people

Person(admin, "Administrator", "Finds people in the directory and opens their records")
Person(mentor, "Mentor", "Reads the record of a participant in scope")
Person(dev, "Application developer", "Builds the Word Up directory and record screens from Cornerstone components")

System(cornerstone, "Cornerstone", "Angular UI library supplying the directory and record composites; neither logs nor persists personal data")
System_Ext(app, "Consuming application", "Word Up Angular application owning querying, scoping, authorization, and persistence")
System_Ext(cdk, "Angular CDK", "Behaviour primitives for key management and layout observation")
System_Ext(npm, "npm registry", "Distributes the published package")
System_Ext(browser, "Browser platform", "Renders the directory and reports viewport width")

Rel(dev, cornerstone, "Composes the directory and record screens from")
Rel(dev, app, "Implements directory and person services in")
Rel(app, cornerstone, "Supplies the scoped and ordered view models to")
Rel(cornerstone, app, "Emits query, selection, row, and section intents to")
Rel(cornerstone, cdk, "Builds tab and layout behaviour on")
Rel(cornerstone, npm, "Is published to")
Rel(app, npm, "Installs from")
Rel(cornerstone, browser, "Renders the rows and sections into")
Rel(browser, admin, "Presents the directory and record to")
Rel(browser, mentor, "Presents the record to")
Rel(admin, browser, "Searches, filters, and selects in")
@enduml
