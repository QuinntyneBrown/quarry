@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Summarize a metric

class MetricDelta {
  +value: number
  +direction: CsDeltaDirection
  +sentiment: CsDeltaSentiment
  +label?: string
}

enum CsDeltaDirection {
  up
  down
  flat
}

enum CsDeltaSentiment {
  positive
  negative
  neutral
}

enum CsMetricTone {
  neutral
  success
  warning
  error
  info
  lime
}

enum CsStatInteraction {
  static
  selectable
  link
}

class StatCardComponent {
  +label: InputSignal<string>
  +value: InputSignal<string | number>
  +unit: InputSignal<string | null>
  +delta: InputSignal<MetricDelta | null>
  +supporting: InputSignal<string | null>
  +tone: InputSignal<CsMetricTone>
  +interaction: InputSignal<CsStatInteraction>
  +state: InputSignal<CsDataState<void>>
  +activated: OutputEmitterRef<void>
  +selectedChange: OutputEmitterRef<boolean>
}

class KpiComponent {
  +label: InputSignal<string>
  +value: InputSignal<string | number>
  +unit: InputSignal<string | null>
  +delta: InputSignal<MetricDelta | null>
  +tone: InputSignal<CsMetricTone>
  +size: InputSignal<CsKpiSize>
}

class ProgressMatrixComponent {
  +rows: InputSignal<CsMatrixRow[]>
  +columns: InputSignal<CsMatrixColumn[]>
  +stickyHeaders: InputSignal<boolean>
  +state: InputSignal<CsDataState<void>>
  +cellActivated: OutputEmitterRef<CsMatrixCellRef>
  -summarize(): CsMatrixSummary
}

class CsMatrixRow {
  +key: string
  +label: string
  +cells: CsMatrixCell[]
}

class CsMatrixColumn {
  +key: string
  +label: string
  +abbreviation?: string
}

class CsMatrixCell {
  +columnKey: string
  +state: MatrixCellState
  +note?: string
}

enum MatrixCellState {
  done
  inProgress
  none
  notApplicable
}

class CsMatrixSummary {
  +done: number
  +inProgress: number
  +none: number
  +notApplicable: number
}

class CsMetricSeries {
  +key: string
  +label: string
  +tone?: CsMetricTone
  +points: CsMetricPoint[]
}

class CsMetricPoint {
  +key: string
  +label: string
  +value: number
  +formatted?: string
}

class MetricBarsComponent {
  +series: InputSignal<CsMetricSeries[]>
  +max: InputSignal<number | null>
  +mode: InputSignal<CsMetricBarsMode>
  +showLegend: InputSignal<boolean>
  +showValueTable: InputSignal<boolean>
  +state: InputSignal<CsDataState<void>>
  +pointActivated: OutputEmitterRef<CsMetricPointRef>
}

enum CsMetricBarsMode {
  bars
  distribution
}

class ComparisonChartComponent {
  +series: InputSignal<CsMetricSeries[]>
  +baselineKey: InputSignal<string>
  +showDelta: InputSignal<boolean>
  +state: InputSignal<CsDataState<void>>
  -deltaFor(series: CsMetricSeries): MetricDelta
}

class MetricValueTableComponent {
  +series: InputSignal<CsMetricSeries[]>
  +visible: InputSignal<boolean>
}

class MetricLegendComponent {
  +series: InputSignal<CsMetricSeries[]>
}

interface CsDataState<T> {
  +kind: CsDataStateKind
}

StatCardComponent o-- MetricDelta : presents
StatCardComponent --> CsMetricTone : has
StatCardComponent --> CsStatInteraction : has
StatCardComponent ..> CsDataState : renders states of
KpiComponent o-- MetricDelta : presents
KpiComponent --> CsMetricTone : has
MetricDelta --> CsDeltaDirection : has
MetricDelta --> CsDeltaSentiment : has
ProgressMatrixComponent *-- "1..*" CsMatrixRow : contains
ProgressMatrixComponent *-- "1..*" CsMatrixColumn : contains
CsMatrixRow *-- "1..*" CsMatrixCell : contains
CsMatrixCell --> MatrixCellState : has
ProgressMatrixComponent ..> CsMatrixSummary : derives
CsMetricSeries *-- "1..*" CsMetricPoint : contains
MetricBarsComponent --> "1..*" CsMetricSeries : renders
MetricBarsComponent --> CsMetricBarsMode : has
ComparisonChartComponent --> "2..*" CsMetricSeries : renders
ComparisonChartComponent ..> MetricDelta : derives
MetricBarsComponent *-- MetricValueTableComponent : renders
ComparisonChartComponent *-- MetricValueTableComponent : renders
MetricBarsComponent *-- MetricLegendComponent : renders
ComparisonChartComponent *-- MetricLegendComponent : renders
@enduml
