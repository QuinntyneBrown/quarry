@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Filter and reset discovery
enum DiscoveryMode {
  Browse
  Search
}
class DiscoverySnapshot {
  +DiscoveryMode Mode
  +string SubmittedQuery
  +string Technology
  +string Cursor
  +int RequestIdentity
}
class DiscoveryState {
  +DiscoverySnapshot Current
  +SetTechnology(value: string): void
  +ClearSearch(): void
  +BrowseAll(): void
  +Accept(snapshot: DiscoverySnapshot): bool
}
class DiscoveryActions {
  +Retry(): void
  +BrowseAll(): void
}
class DiscoveryResultRegion {
  +Render(snapshot: DiscoverySnapshot): ReactNode
}
DiscoveryState --> DiscoverySnapshot : owns
DiscoverySnapshot --> DiscoveryMode : has
DiscoveryActions --> DiscoveryState : changes
DiscoveryResultRegion --> DiscoveryState : reads
@enduml
