@startuml
title UML sequence behaviour — Inspect framework
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Visitor" as visitor
box "Frontend — Quarry application" #E0F2FE
participant "FrameworkCard" as card
participant "FrameworkDetailsDialog" as dialog
participant "ModalFocusTrap" as focus
participant "FrameworkDetailsClient" as client
end box
box "Backend — Quarry API application" #D1FADF
participant "FrameworksController" as controller
end box
visitor -> card : Explore framework
card -> dialog : Capture discovery, scroll and opener; open request identity
dialog -> focus : Move focus to Close; inert background L2-025
dialog -> client : Load published detail
client -> controller : GET /api/frameworks/{id}
controller --> client : Detail or safe failure
client --> dialog : Response with detail request identity
alt Dialog closed/replaced or response obsolete
 dialog -> dialog : Ignore response L2-035
else Available revision
 dialog -> dialog : Render Overview and reconcile selected summary
 opt Detail revision differs from recommendation
  dialog --> visitor : Updated notice; discard old explanation L2-015
 end
else 404 or retryable service failure
 dialog --> visitor : Unavailable status, Close, disabled selection
 opt Retryable failure
  visitor -> dialog : Retry after any quota delay
  dialog -> client : New detail request identity
 end
end
visitor -> dialog : Arrow, Home or End on detail tab
dialog --> visitor : Focus active tab and panel L2-025
visitor -> dialog : Close, Escape or outside backdrop
dialog -> client : Cancel outstanding detail request
dialog -> focus : Restore scroll and connected opener or result heading L2-017
note over dialog : Reopening creates default preview state.
@enduml
